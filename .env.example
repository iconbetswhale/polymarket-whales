DASHBOARD_REFRESH=15
DASHBOARD_PORT=5000
WALLETS_FILE=wallets.json
DATABASE_PATH=polymarket_tracker.db
# Required on serverless hosts. Neon/Vercel may inject DATABASE_URL automatically.
DURABLE_DATABASE_URL=
SPORTS_ONLY=true
RESOLVE_HOURS=168
MIN_AMERICAN_ODDS=
MAX_AMERICAN_ODDS=
REQUEST_TIMEOUT=15
MAX_RETRIES=3
DEFAULT_BANKROLL=10000
UNIT_PERCENTAGE=0.01
# Release 3 execution controls.
EXECUTION_QUOTE_MAX_AGE_SECONDS=60
EXECUTION_WIDE_SPREAD_FRACTION=0.03
# Trades-to-Play line shopping (read-only execution comparison).
LINE_SHOP_MAX_QUOTE_AGE_SECONDS=60
LINE_SHOP_REFRESH_INTERVAL_SECONDS=5
LINE_SHOP_MIN_LIQUIDITY=0
LINE_SHOP_INCLUDE_FEES=true
MINIMUM_EDGE_DISCOVERY=0.01
MINIMUM_EDGE_B=0.015
MINIMUM_EDGE_A=0.02
MINIMUM_EDGE_A_PLUS=0.025
# Release 3 portfolio caps as fractions of bankroll.
MAX_SINGLE_POSITION_FRACTION=0.02
MAX_GAME_EXPOSURE_FRACTION=0.025
MAX_TEAM_DAY_EXPOSURE_FRACTION=0.04
MAX_DAILY_EXPOSURE_FRACTION=0.06
MAX_CORRELATED_CLUSTER_FRACTION=0.04
MAX_PROVIDER_EXPOSURE_FRACTION=0.10
# Release 4 learning-system safeguards.
EDGE_MAP_INSUFFICIENT_SAMPLE_COUNT=25
EDGE_MAP_MODERATE_SAMPLE_COUNT=100
EDGE_MAP_STRONG_SAMPLE_COUNT=250
EDGE_MAP_MINIMUM_HOLDOUT_COUNT=50
ADMIN_PASSWORD=
DISCORD_WEBHOOK_URL=
DISCORD_ALERT_TYPES=new_entry,size_increase,full_exit
DISCORD_MIN_POSITION_USD=0
DISCORD_NOTIFY_ON_INITIAL_SCAN=false
# Model Tracker bot notifications. All values are server-side only.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_TRADE_CHANNEL_ID=
DISCORD_NOTIFICATIONS_ENABLED=false
DISCORD_NOTIFICATION_BATCH_SIZE=10
# The Vercel production cron reconciles tracked wallets once per minute.
TRACKER_JOB_INTERVAL_SECONDS=60
# SportsGameOdds All Lines key used by Positive EV and normalized NoVIG markets.
SPORTSGAMEODDS_API_KEY=
SPORTSGAMEODDS_API_BASE_URL=https://api.sportsgameodds.com/v2
SPORTSGAMEODDS_CACHE_TTL_SECONDS=45
# Backward-compatible alias. Prefer SPORTSGAMEODDS_API_KEY for new deployments.
NOVIG_ODDS_API_KEY=
NOVIG_ODDS_API_BASE_URL=https://api.sportsgameodds.com/v2
NOVIG_ODDS_CACHE_TTL_SECONDS=45
# Direct NoVIG production NBX read-only exchange feed. Both credentials must
# remain server-side. NOVIG_ENABLED is the provider kill switch.
NOVIG_ENABLED=true
NOVIG_CLIENT_ID=
NOVIG_CLIENT_SECRET=
NOVIG_AUTH_URL=https://api.novig.us/nbx/v1/auth/emm-token
NOVIG_REST_BASE_URL=https://api.novig.us/nbx/v2
NOVIG_WEBSOCKET_URL=wss://api.novig.us/tape
NOVIG_NBX_CACHE_TTL_SECONDS=10
NOVIG_STALE_AFTER_SECONDS=30
NOVIG_WORKER_FLUSH_SECONDS=0.5
# Zero uses REST for every authoritative bootstrap and subscribes only to the
# global tape/lifecycle channels. Raise to also request market-specific books.
NOVIG_WS_MARKET_SUBSCRIPTION_LIMIT=0
# Optional override. Defaults to the existing durable Postgres database URL.
NOVIG_STATE_DATABASE_URL=
# ProphetX sandbox Trading API credentials. Keep both keys server-side.
PROPHETX_ACCESS_KEY=
PROPHETX_SECRET_KEY=
PROPHETX_API_BASE_URL=https://api-ss-sandbox.betprophet.co/partner
PROPHETX_TRADE_URL=https://ss-sandbox.betprophet.co/
PROPHETX_CACHE_TTL_SECONDS=30
# Direct ProphetX is a local fallback. In production an OddsEngine Advanced key
# reads the materialized ProphetX order book automatically at a bounded cadence.
SHARP_MONEY_PROPHETX_POLL_SECONDS=1
SHARP_MONEY_COMPARISON_SECONDS=60
SHARP_MONEY_ODDSENGINE_REFRESH_SECONDS=30
# Requires an OddsEngine Advanced key; enables NoVIG + ProphetX order books.
SHARP_MONEY_ADVANCED_ORDERBOOK_ENABLED=false
SHARP_MONEY_SEED_REFRESH_SECONDS=60
SHARP_MONEY_TOURNAMENTS=MLB,WNBA
# 4CX read-only exchange integration. Credentials stay server-side.
FOURCX_USERNAME=
FOURCX_PASSWORD=
FOURCX_API_BASE_URL=https://api.4cx.io
FOURCX_ENABLED=false
FOURCX_TRADING_ENABLED=false
FOURCX_CACHE_TTL_SECONDS=30
# Kalshi public read-only REST market data; no account key is required.
KALSHI_ENABLED=true
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_CACHE_TTL_SECONDS=1
# OddsEngine primary all-book read-only feed for live tools, DFS, Odds Screen,
# model fair pricing, line shopping, and Advanced ProphetX order books.
ODDSENGINE_API_KEY=
ODDSENGINE_API_BASE_URL=https://api.oddsengine.dev/v1
ODDSENGINE_CACHE_TTL_SECONDS=45
# Caps keep the first four-league scan within the trial plan's 60 req/minute.
ODDSENGINE_MAX_EVENTS_PER_LEAGUE=5
ODDSENGINE_MAX_TOTAL_EVENTS=20
# The Odds API read-only sportsbook aggregation. Never commit the real key.
# Longer server and edge caches protect the monthly request-credit allowance.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_API_REGIONS=us,us2,us_ex,us_dfs,uk,au,se,fr
THE_ODDS_API_MARKETS=h2h,spreads,totals
THE_ODDS_API_DEFAULT_SPORTS=baseball_mlb
THE_ODDS_API_TRADE_BOOKMAKERS=kalshi,novig,polymarket,prophetx
THE_ODDS_API_CACHE_TTL_SECONDS=60
THE_ODDS_API_ALTERNATE_CACHE_TTL_SECONDS=1200
THE_ODDS_API_MAX_QUOTE_AGE_SECONDS=1800
# Global server-side kill switch for the paid Positive EV scanner.
POSITIVE_EV_ENABLED=false
# Account OAuth and billing. Configure production values in Vercel only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
STRIPE_CUSTOMER_PORTAL_URL=
WALLET_PAGE_PASSCODE=
WALLET_PAGE_LOCK_SECRET=
DISCORD_CHECKPOINT_CHANNEL_ID=
DISCORD_CHECKPOINT_CHANNEL_NAME=model-tracker-30m
